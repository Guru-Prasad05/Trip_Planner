# Public site origin (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Supabase — copy values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional alias kept for backward-compat:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Server-only — NEVER commit real value, set in Netlify dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
